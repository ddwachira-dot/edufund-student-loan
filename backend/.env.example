# Copy to .env and adjust for your machine
PORT=5000
# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/student_loan
JWT_SECRET=change-this-to-a-long-random-string
# Paystack API keys (Dashboard -> Settings -> API Keys & Webhooks)
PAYSTACK_SECRET_KEY=sk_live_your-secret-key
PAYSTACK_PUBLIC_KEY=pk_live_your-public-key
PAYSTACK_BASE_URL=https://api.paystack.co

# Automated decision runner — DANGEROUS, off by default.
# When enabled it approves identity documents and rejects applications without a
# human reviewing them, and bans the rejected borrowers' emails on login.
# Never enable against a database with real borrowers.
# SIMULATION_ENABLED=true
# SIMULATION_INTERVAL_MS=300000
# SIMULATION_INITIAL_DELAY_MS=10000
# SIMULATION_APPROVE_VERIFICATIONS=7
# SIMULATION_REJECT_APPLICATIONS=3
# SIMULATION_REJECT_REASON=Did not meet eligibility criteria (automated review)